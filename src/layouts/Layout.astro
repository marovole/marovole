---
import '../styles/global.css';

const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: 'zh' | 'en';
  langPaths?: { zh: string; en: string };
  ogType?: 'website' | 'article';
  publishedTime?: string;
  markdownAlternate?: string;
  noindex?: boolean;
  extraJsonLd?: Record<string, unknown>[];
}

const {
  title,
  description: desc,
  image: ogImageProp,
  lang: langProp,
  langPaths,
  ogType = 'website',
  publishedTime,
  markdownAlternate,
  noindex = false,
  extraJsonLd = [],
} = Astro.props;

const pathnameRaw = Astro.url.pathname;
const lang: 'zh' | 'en' = langProp ?? (pathnameRaw === '/en' || pathnameRaw.startsWith('/en/') ? 'en' : 'zh');

const defaultDesc =
  lang === 'zh'
    ? '翡冷翠 (marovole) · 12 年产品经理与一线 FDE。不用学写代码，学会像产品经理一样指挥 AI。开源 marovole-skills 与 AI 实测研究主场。'
    : 'marovole (翡冷翠) · 12y Product Director & Forward Deployed Engineer. Crafting verifiable Agent systems, plain-text skills, and grounded AI benchmarks.';

const description = desc || defaultDesc;
const imagePath = ogImageProp || '/images/og.png';

const site = Astro.site ?? new URL('https://marovole.com/');

function normalizePagePath(p: string): string {
  const withLead = p.startsWith('/') ? p : `/${p}`;
  if (withLead === '/' || /\.[a-z0-9]+$/i.test(withLead)) return withLead;
  return withLead.endsWith('/') ? withLead : `${withLead}/`;
}

const canonicalPath = normalizePagePath(pathnameRaw === '/zh' || pathnameRaw === '/zh/' ? '/' : pathnameRaw);
const canonicalURL = new URL(canonicalPath, site).href;

function toAbsoluteAsset(href: string): string {
  if (href.startsWith('http://') || href.startsWith('https://')) return href;
  const path = href.startsWith('/') ? href : `/${href}`;
  return new URL(path, site).href;
}

const ogImage = toAbsoluteAsset(imagePath);
const langAttr = lang === 'zh' ? 'zh-CN' : 'en';
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const ogLocaleAlternate = lang === 'zh' ? 'en_US' : 'zh_CN';

const hreflangLinks = langPaths
  ? [
      { hreflang: 'zh-CN', href: new URL(normalizePagePath(langPaths.zh), site).href },
      { hreflang: 'en', href: new URL(normalizePagePath(langPaths.en), site).href },
      { hreflang: 'x-default', href: new URL(normalizePagePath(langPaths.zh), site).href },
    ]
  : null;

const personId = `${site.origin}/#person`;
const websiteId = `${site.origin}/#website`;

const jsonLdGraph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': personId,
    name: '翡冷翠',
    alternateName: ['marovole', '翡冷翠的AI笔记', 'Hermes-marovole'],
    jobTitle: 'Product Director & Forward Deployed Engineer',
    description:
      '12-year Product Manager (5-year consumer founder) and Forward Deployed Engineer enabling non-technical teams to deploy verifiable AI Agent workflows.',
    url: `${site.origin}/`,
    knowsAbout: [
      'AI Agent Engineering',
      'Forward Deployed Engineering (FDE)',
      'Product Management',
      'Claude Code',
      'OpenAI Codex',
      'Hermes Agent',
      'Workflow Verification & Grounding',
      'Engineering Aesthetics',
    ],
    sameAs: [
      'https://github.com/marovole',
      'https://github.com/Hermes-marovole',
      'https://x.com/marovole',
      'https://twitter.com/marovole',
      'https://www.linkedin.com/in/marovole-lu-4866ab245',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    name: '翡冷翠 · marovole',
    alternateName: ['marovole.com', '翡冷翠的AI笔记'],
    url: `${site.origin}/`,
    inLanguage: ['zh-CN', 'en-US'],
    publisher: { '@id': personId },
  },
  ...extraJsonLd,
];
---

<!doctype html>
<html lang={langAttr} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Noto+Sans+SC:wght@300;400;500;600&family=Noto+Serif+SC:wght@500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Default Light Mode -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('marovole-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <!-- SEO & GEO Discovery -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="翡冷翠 (marovole)" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {hreflangLinks?.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
    <link rel="alternate" type="application/rss+xml" title="翡冷翠 · marovole RSS Feed" href={`${site.origin}/rss.xml`} />
    <link rel="alternate" type="text/plain" title="LLMs Index" href={`${site.origin}/llms.txt`} />
    {markdownAlternate && (
      <link rel="alternate" type="text/markdown" title="Markdown Source" href={toAbsoluteAsset(markdownAlternate)} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="翡冷翠 · marovole" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@marovole" />
    <meta name="twitter:creator" content="@marovole" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@graph': jsonLdGraph,
        })}
      />
    )}

    <!-- Cloudflare Web Analytics -->
    {cfBeaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
    <script>
      // ─── MAR-62 spec: outbound click tracking ──────────────────────────────
      function trackEvent(eventName: string, props: Record<string, string>): void {
        try {
          console.debug('[track]', eventName, props);
          const KEY = 'marvole_track_events';
          const list: unknown[] = JSON.parse(localStorage.getItem(KEY) ?? '[]');
          list.push({ ts: Date.now(), event: eventName, ...props });
          localStorage.setItem(KEY, JSON.stringify(list.slice(-200)));
          (window as any).zaraz?.track(eventName, props);
        } catch {
          // silent failure — never block link navigation
        }
      }

      function initOutboundTracking(): void {
        if (typeof window === 'undefined') return;
        if ((window as any).__trackInitialized) return;
        (window as any).__trackInitialized = true;

        document.addEventListener('click', (e) => {
          const el = (e.target as Element).closest<HTMLAnchorElement>('[data-track]');
          if (!el) return;

          const key = el.href;
          const now = Date.now();
          const lastClick: Record<string, number> = (window as any).__trackLastClick ?? {};
          if (now - (lastClick[key] ?? 0) < 300) return;
          lastClick[key] = now;
          (window as any).__trackLastClick = lastClick;

          trackEvent(el.dataset.track ?? 'outbound_click', {
            href: el.href ?? '',
            label: el.dataset.trackLabel ?? '',
            location: el.dataset.trackLocation ?? '',
            text: el.innerText?.trim() ?? '',
          });
        });
      }

      initOutboundTracking();
      (window as any).trackEvent = trackEvent;
    </script>
  </body>
</html>
