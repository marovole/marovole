---
import type { CollectionEntry } from 'astro:content';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: 'en' | 'zh';
  backLink: string;
  switchHref?: string;
}

const { project, lang, backLink, switchHref } = Astro.props;
const isZh = lang === 'zh';
const { Content } = await project.render();

const locale = isZh ? 'zh-CN' : 'en-US';
const formatDate = (date: string | Date) => {
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' });
};
---

<Header lang={lang} switchHref={switchHref} />

<main id="main-content" class="flex-grow pt-28 pb-16">
  <article class="max-w-4xl mx-auto px-6">
    <a
      href={backLink}
      class="inline-flex items-center gap-2 text-sm text-[var(--ink-soft)] hover:text-[var(--ink)] transition-colors mb-10 mono"
    >
      <span aria-hidden="true">←</span>
      <span>{isZh ? '返回作品集' : 'Back to Works'}</span>
    </a>

    <div class="flex flex-wrap items-center gap-2 mb-5">
      {project.data.tags.map((tag) => (
        <span class="px-3 py-1 text-xs mono rounded-full border border-[var(--line-strong)] text-[var(--ink-soft)] bg-[var(--pill-bg)]">
          {tag}
        </span>
      ))}
    </div>

    <h1 class="serif text-4xl md:text-6xl font-semibold tracking-tight text-[var(--ink)] mb-5 leading-[1.12]">
      {project.data.title}
    </h1>

    <p class="text-lg md:text-xl text-[var(--ink-soft)] leading-relaxed mb-8 max-w-2xl">
      {project.data.description}
    </p>

    <div class="flex flex-wrap items-center gap-3 pb-10 border-b border-[var(--line)]">
      {project.data.demoUrl && (
        <a
          href={project.data.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track="outbound_click"
          data-track-label="project_demo"
          data-track-location="project_card"
          class="cta-dark"
        >
          <span>{isZh ? '访问项目' : 'Visit Project'}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {project.data.repoUrl && (
        <a
          href={project.data.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track="outbound_click"
          data-track-label="project_github"
          data-track-location="project_card"
          class="cta-glass"
        >
          <span>{isZh ? '查看源码' : 'View Source'}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      <span class="text-xs mono text-[var(--ink-faint)] ml-auto">
        {formatDate(project.data.date)}
      </span>
    </div>

    {project.data.image && (
      <div class="my-10 overflow-hidden rounded-[22px] border border-[var(--line)] shadow-[var(--card-shadow)] bg-[var(--bg-card)]">
        <img
          src={project.data.image}
          alt={project.data.title}
          class="w-full max-h-[460px] object-cover object-top"
          decoding="async"
        />
      </div>
    )}

    <div class="atelier-prose max-w-3xl mx-auto pt-4">
      <Content />
    </div>
  </article>
</main>

<Footer lang={lang} />
