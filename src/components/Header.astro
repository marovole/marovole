---
interface Props {
  lang?: 'zh' | 'en';
  switchHref?: string;
}

const pathname = Astro.url.pathname;
const lang: 'zh' | 'en' = Astro.props.lang ?? (pathname === '/en' || pathname.startsWith('/en/') ? 'en' : 'zh');
const homeHref = lang === 'en' ? '/en/' : '/';
const switchHref = Astro.props.switchHref ?? (lang === 'en' ? '/' : '/en/');
---

<a href="#main-content" class="skip-to-main mono text-xs">
  {lang === 'zh' ? '跳至主要内容' : 'Skip to main content'}
</a>

<header class="topbar">
  <a href={homeHref} class="logo-pill">
    <span class="live-beacon" aria-hidden="true"></span>
    {lang === 'zh' ? (
      <>
        <span class="serif" style="font-size:18px;">翡冷翠</span>
        <span class="mono" style="font-size:12px; opacity:0.55;">marovole</span>
      </>
    ) : (
      <>
        <span class="serif" style="font-size:19px;">marovole</span>
        <span class="mono" style="font-size:11.5px; opacity:0.55;">翡冷翠</span>
      </>
    )}
  </a>

  <nav class="nav-dock" aria-label={lang === 'zh' ? '主导航' : 'Primary navigation'}>
    <a href={`${homeHref}#works`} class="dock-link">
      {lang === 'zh' ? '造物 Works' : 'Selected Works'}
    </a>
    <a href={`${homeHref}#essays`} class="dock-link">
      {lang === 'zh' ? '思考 Essays' : 'Field Notes'}
    </a>
    <a href={`${homeHref}#atelier`} class="dock-link">
      {lang === 'zh' ? '关于 Atelier' : 'Atelier'}
    </a>
  </nav>

  <div class="ctrl-group mono">
    <a href={switchHref} class="icon-pill" aria-label={lang === 'zh' ? 'Switch to English' : '切换中文'}>
      {lang === 'zh' ? 'EN' : '中文'}
    </a>
    <button
      type="button"
      class="icon-pill"
      id="atelier-theme-toggle"
      aria-label={lang === 'zh' ? '切换亮色与暗色主题' : 'Toggle light and dark theme'}
    >
      ◐
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('atelier-theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var cur = document.documentElement.getAttribute('data-theme') || 'light';
      var next = cur === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('marovole-theme', next);
      } catch (e) {}
    });
  })();
</script>
