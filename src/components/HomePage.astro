---
import type { CollectionEntry } from 'astro:content';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Experience from './Experience.astro';
import ProjectGrid from './ProjectGrid.astro';
import Footer from './Footer.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'en' | 'zh';
  featuredProjects: CollectionEntry<'projects'>[];
}

const { lang, featuredProjects } = Astro.props;
const t = useTranslations(lang);
---

<Header />
<main id="main-content" class="flex-grow">
  <Hero />
  <Experience />
  <ProjectGrid projects={featuredProjects} />

  <section id="about" class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-[var(--color-text)] mb-8 text-center font-mono">
        <span class="gradient-text">{t('about.title')}</span>
      </h2>
      <div class="prose prose-lg prose-invert max-w-none mx-auto text-[var(--color-text-muted)]">
        <p class="mb-6 font-mono text-sm">{t('about.p1')}</p>
        <p class="mb-6 font-mono text-sm">{t('about.p2')}</p>
        <p class="font-mono text-sm">{t('about.p3')}</p>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
        <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)]">
          <div class="text-3xl font-bold neon-text-cyan mb-2 font-mono">10+</div>
          <div class="text-sm text-[var(--color-text-muted)] font-mono">{t('about.stats.exp')}</div>
        </div>
        <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)]">
          <div class="text-3xl font-bold neon-text-magenta mb-2 font-mono">20+</div>
          <div class="text-sm text-[var(--color-text-muted)] font-mono">{t('about.stats.projects')}</div>
        </div>
        <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)]">
          <div class="text-3xl font-bold text-[var(--color-accent)] mb-2 font-mono">10+</div>
          <div class="text-sm text-[var(--color-text-muted)] font-mono">{t('about.stats.opensource')}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-[var(--color-text)] mb-4 font-mono">
        {t('contact.title')}<span class="gradient-text">{t('contact.titleHighlight')}</span>
      </h2>
      <p class="text-[var(--color-text-muted)] mb-8 font-mono text-sm">
        {t('contact.desc')}
      </p>
      <a
        href="mailto:marovole@gmail.com"
        class="inline-block px-8 py-4 rounded-[var(--radius-button)] bg-[var(--color-primary)] text-[var(--color-bg)] font-semibold hover:shadow-[var(--shadow-neon-cyan)] transition-shadow duration-300 btn-neon-fill"
      >
        {t('contact.cta')}
      </a>
    </div>
  </section>
</main>
<Footer />
