---
interface Props {
  lang?: 'zh' | 'en';
}

const pathname = Astro.url.pathname;
const lang: 'zh' | 'en' = Astro.props.lang ?? (pathname === '/en' || pathname.startsWith('/en/') ? 'en' : 'zh');
const currentYear = new Date().getFullYear();
---

<footer class="max-w-[1240px] w-full mx-auto px-5 md:px-9 pb-12 pt-6 mt-auto">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[12.5px] text-[var(--ink-faint)] mono border-t border-[var(--line)] pt-6">
    <span>
      &copy; {currentYear} {lang === 'zh' ? '翡冷翠 · MAROVOLE' : 'MAROVOLE · 翡冷翠'}
    </span>

    <div class="flex items-center gap-5">
      <a
        href="https://github.com/marovole"
        target="_blank"
        rel="noopener noreferrer"
        data-track="outbound_click"
        data-track-label="github"
        data-track-location="footer"
        class="text-[var(--ink-soft)] hover:text-[var(--ink)] transition-colors"
      >
        GitHub ↗
      </a>
      <a
        href="https://x.com/marovole"
        target="_blank"
        rel="noopener noreferrer"
        data-track="outbound_click"
        data-track-label="twitter"
        data-track-location="footer"
        class="text-[var(--ink-soft)] hover:text-[var(--ink)] transition-colors"
      >
        X / Twitter ↗
      </a>
      <a
        href="https://www.linkedin.com/in/marovole-lu-4866ab245"
        target="_blank"
        rel="noopener noreferrer"
        data-track="outbound_click"
        data-track-label="linkedin"
        data-track-location="footer"
        class="text-[var(--ink-soft)] hover:text-[var(--ink)] transition-colors"
      >
        LinkedIn ↗
      </a>
      <a
        href="mailto:marovole@gmail.com"
        data-track="outbound_click"
        data-track-label="mailto_footer"
        data-track-location="footer"
        class="text-[var(--ink-soft)] hover:text-[var(--ink)] transition-colors"
      >
        Email
      </a>
    </div>
  </div>
</footer>
