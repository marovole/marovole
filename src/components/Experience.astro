---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="experience" class="py-24 px-6 relative">
  <!-- Background decoration -->
  <div class="absolute inset-0 pointer-events-none opacity-10" style="background-image: linear-gradient(90deg, var(--color-secondary) 1px, transparent 1px), linear-gradient(180deg, var(--color-secondary) 1px, transparent 1px); background-size: 50px 50px;"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    <!-- Title -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 font-mono">
        <span class="gradient-text">{t('experience.title')}</span>
      </h2>
      <div class="w-24 h-1 bg-gradient-to-r from-[var(--color-primary)] via-[var(--color-secondary)] to-[var(--color-accent)] mx-auto"></div>
    </div>

    <!-- Core manifesto -->
    <div class="mb-16 p-8 rounded-[var(--radius-card)] border border-[var(--color-primary)] bg-[var(--color-bg-card)] relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[var(--color-primary)] to-transparent"></div>
      <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[var(--color-primary)] to-transparent"></div>

      <p class="text-lg text-[var(--color-text)] leading-relaxed font-mono">
        {lang === 'zh' ? (
          <>
            {t('experience.manifesto.zh_before_title')}
            <span class="neon-text-cyan">{t('experience.title')}</span>
            {t('experience.manifesto.zh_after_title')}
            <span class="neon-text-magenta">{t('hero.token')}</span>
            {t('experience.manifesto.zh_suffix')}
          </>
        ) : (
          <>
            {t('experience.manifesto.en_lead')}
            <span class="neon-text-cyan">{t('experience.manifesto.en_role')}</span>
            {t('experience.manifesto.en_mid')}
            <span class="neon-text-magenta">{t('hero.token')}</span>
            {t('experience.manifesto.en_suffix')}
          </>
        )}
      </p>
    </div>

    <!-- AI Development Process -->
    <div class="mb-16">
      <h3 class="text-xl font-semibold mb-6 text-[var(--color-text)] font-mono">
        <span class="text-[var(--color-primary)]">▸</span> {t('experience.process')}
      </h3>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Research Phase -->
        <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)] text-center group hover:border-[var(--color-secondary)] transition-[border-color,box-shadow] duration-300">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full border border-[var(--color-secondary)] flex items-center justify-center">
            <span class="text-2xl">🔍</span>
          </div>
          <h4 class="font-semibold text-[var(--color-text)] mb-2">{t('experience.phase.research')}</h4>
          <p class="text-xs text-[var(--color-text-muted)] font-mono mb-3">{t('experience.phase.research.sub')}</p>
          <div class="flex flex-wrap justify-center gap-1">
            <span class="px-2 py-0.5 text-xs rounded bg-[var(--color-secondary)]/20 text-[var(--color-secondary)] font-mono">ChatGPT</span>
            <span class="px-2 py-0.5 text-xs rounded bg-[var(--color-secondary)]/20 text-[var(--color-secondary)] font-mono">Gemini</span>
          </div>
        </div>

        <!-- Development Phase -->
        <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)] text-center group hover:border-[var(--color-primary)] transition-[border-color,box-shadow] duration-300">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full border border-[var(--color-primary)] flex items-center justify-center">
            <span class="text-2xl">⚡</span>
          </div>
          <h4 class="font-semibold text-[var(--color-text)] mb-2">{t('experience.phase.dev')}</h4>
          <p class="text-xs text-[var(--color-text-muted)] font-mono mb-3">{t('experience.phase.dev.sub')}</p>
          <div class="flex flex-wrap justify-center gap-1">
            <span class="px-2 py-0.5 text-xs rounded bg-[var(--color-primary)]/20 text-[var(--color-primary)] font-mono">Claude</span>
            <span class="px-2 py-0.5 text-xs rounded bg-[var(--color-primary)]/20 text-[var(--color-primary)] font-mono">OpenSpec</span>
          </div>
        </div>

        <!-- Review Phase -->
        <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)] text-center group hover:border-[var(--color-accent)] transition-[border-color,box-shadow] duration-300">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full border border-[var(--color-accent)] flex items-center justify-center">
            <span class="text-2xl">🛡️</span>
          </div>
          <h4 class="font-semibold text-[var(--color-text)] mb-2">{t('experience.phase.review')}</h4>
          <p class="text-xs text-[var(--color-text-muted)] font-mono mb-3">{t('experience.phase.review.sub')}</p>
          <div class="flex flex-wrap justify-center gap-1">
            <span class="px-2 py-0.5 text-xs rounded bg-[var(--color-accent)]/20 text-[var(--color-accent)] font-mono">Codex</span>
          </div>
        </div>

        <!-- Deployment Phase -->
        <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)] text-center group hover:border-[var(--color-secondary)] transition-[border-color,box-shadow] duration-300">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full border border-[var(--color-secondary)] flex items-center justify-center">
            <span class="text-2xl">🚀</span>
          </div>
          <h4 class="font-semibold text-[var(--color-text)] mb-2">{t('experience.phase.deploy')}</h4>
          <p class="text-xs text-[var(--color-text-muted)] font-mono mb-3">{t('experience.phase.deploy.sub')}</p>
          <div class="flex flex-wrap justify-center gap-1">
            <span class="px-2 py-0.5 text-xs rounded bg-[var(--color-secondary)]/20 text-[var(--color-secondary)] font-mono">Vercel</span>
            <span class="px-2 py-0.5 text-xs rounded bg-[var(--color-secondary)]/20 text-[var(--color-secondary)] font-mono">Supabase</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Delivery Capabilities -->
    <div class="mb-16">
      <h3 class="text-xl font-semibold mb-6 text-[var(--color-text)] font-mono">
        <span class="text-[var(--color-primary)]">▸</span> {t('experience.capability.title')}
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Simple Project -->
        <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)] text-center hover:shadow-[var(--shadow-neon-cyan)] transition-[box-shadow,border-color] duration-300">
          <div class="text-4xl font-bold neon-text-cyan mb-2 font-mono">3-4h</div>
          <div class="text-sm text-[var(--color-text-muted)] mb-4">{t('experience.capability.simple')}</div>
          <p class="text-xs text-[var(--color-text-muted)]">{t('experience.capability.simple.blurb')}</p>
        </div>

        <!-- Complex Project -->
        <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)] text-center hover:shadow-[var(--shadow-neon-magenta)] transition-[box-shadow,border-color] duration-300">
          <div class="text-4xl font-bold neon-text-magenta mb-2 font-mono">3-5d</div>
          <div class="text-sm text-[var(--color-text-muted)] mb-4">{t('experience.capability.complex')}</div>
          <p class="text-xs text-[var(--color-text-muted)]">{t('experience.capability.complex.blurb')}</p>
        </div>

        <!-- Core Advantage -->
        <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)] text-center hover:shadow-[0_0_20px_rgba(123,63,239,0.4)] transition-[box-shadow,border-color] duration-300">
          <div class="text-4xl font-bold text-[var(--color-accent)] mb-2 font-mono">0-1</div>
          <div class="text-sm text-[var(--color-text-muted)] mb-4">{t('experience.capability.zero_one')}</div>
          <p class="text-xs text-[var(--color-text-muted)]">{t('experience.capability.zero_one.blurb')}</p>
        </div>
      </div>
    </div>

    <!-- Tech Stack -->
    <div>
      <h3 class="text-xl font-semibold mb-6 text-[var(--color-text)] font-mono">
        <span class="text-[var(--color-primary)]">▸</span> {t('experience.stack')}
      </h3>

      <div class="p-6 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-card)]">
        <div class="flex flex-wrap items-center justify-center gap-8">
          <div class="flex items-center gap-2">
            <span class="text-[var(--color-primary)]">◆</span>
            <span class="font-mono text-sm">Vercel</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--color-secondary)]">◆</span>
            <span class="font-mono text-sm">Supabase</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--color-accent)]">◆</span>
            <span class="font-mono text-sm">Google Auth</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--color-primary)]">◆</span>
            <span class="font-mono text-sm">Claude Code</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--color-secondary)]">◆</span>
            <span class="font-mono text-sm">Cursor</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--color-accent)]">◆</span>
            <span class="font-mono text-sm">OpenSpec</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
