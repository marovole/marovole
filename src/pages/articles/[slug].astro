---
import Layout from '../../layouts/Layout.astro';
import ArticleDetail from '../../components/ArticleDetail.astro';
import { loadArticles } from '../../utils/article-loader';

export async function getStaticPaths() {
  const articles = loadArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const site = Astro.site ?? new URL('https://marovole.com/');
const articleUrl = new URL(`/articles/${article.slug}`, site).href;
---

<Layout
  title={`${article.title} | marovole`}
  description={article.description}
  langPaths={{ en: `/articles/${article.slug}`, zh: `/zh/articles/${article.slug}` }}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    datePublished: article.date.toISOString(),
    dateModified: article.date.toISOString(),
    inLanguage: article.lang === 'zh' ? 'zh-CN' : 'en-US',
    url: articleUrl,
    author: {
      '@type': 'Person',
      name: 'marovole',
      url: site.origin,
    },
    publisher: {
      '@type': 'Person',
      name: 'marovole',
      url: site.origin,
    },
  })} slot="head" />
  <ArticleDetail article={article} lang="en" backLink="/articles" />
</Layout>
