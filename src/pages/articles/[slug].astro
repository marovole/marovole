---
import Layout from '../../layouts/Layout.astro';
import ArticleDetail from '../../components/ArticleDetail.astro';
import {
  articleDetailPath,
  getArticleLangPaths,
  loadArticlesForLocale,
} from '../../utils/article-loader';

export async function getStaticPaths() {
  const articles = loadArticlesForLocale('en');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const site = Astro.site ?? new URL('https://marovole.com/');
const articleUrl = new URL(articleDetailPath(article), site).href;
const langPaths = getArticleLangPaths(article);
---

<Layout
  title={`${article.title} | marovole`}
  description={article.description}
  langPaths={langPaths}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    datePublished: article.date.toISOString(),
    dateModified: article.date.toISOString(),
    inLanguage: 'en-US',
    url: articleUrl,
    author: {
      '@type': 'Person',
      name: 'marovole',
      url: site.origin,
    },
    publisher: {
      '@type': 'Person',
      name: 'marovole',
      url: site.origin,
    },
  })} slot="head" />
  <ArticleDetail article={article} lang="en" backLink="/articles" />
</Layout>
