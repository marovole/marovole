---
import Layout from '../../layouts/Layout.astro';
import ArticleListPage from '../../components/ArticleListPage.astro';
import { loadArticles } from '../../utils/article-loader';

const articles = loadArticles();
---

<Layout
  title={`Articles | marovole`}
  description="Long-form articles and guides published as standalone HTML."
  langPaths={{ en: '/articles', zh: '/zh/articles' }}
>
  <ArticleListPage articles={articles} />
</Layout>
