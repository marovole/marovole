---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/HomePage.astro';
import { getCollection } from 'astro:content';

const allEssays = await getCollection('essays');
const essays = allEssays.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="marovole — Where Product Taste Commands Autonomous AI"
  description="marovole (翡冷翠) · 12y Product Director & Forward Deployed Engineer. Open-source marovole-skills, 597-run AI Ambition ablation study, and verifiable Agent engineering."
  lang="en"
  langPaths={{ zh: '/', en: '/en/' }}
>
  <HomePage lang="en" essays={essays} switchHref="/" />
</Layout>
