---
import Layout from '../../../layouts/Layout.astro';
import EssayDetail from '../../../components/EssayDetail.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((essay) => ({
    params: { slug: essay.slug },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const canonicalUrl = `https://marovole.com/en/essays/${essay.slug}/`;
const coverUrl = `https://marovole.com${essay.data.cover}`;

const extraJsonLd = [
  {
    '@type': 'TechArticle',
    '@id': `${canonicalUrl}#article`,
    headline: essay.data.titleEn,
    alternativeHeadline: essay.data.title,
    description: essay.data.descriptionEn,
    image: coverUrl,
    datePublished: `${essay.data.date}T08:00:00+08:00`,
    inLanguage: ['en-US', 'zh-CN'],
    author: { '@id': 'https://marovole.com/#person' },
    publisher: { '@id': 'https://marovole.com/#person' },
    mainEntityOfPage: canonicalUrl,
    articleSection: essay.data.categoryEn,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://marovole.com/en/' },
      { '@type': 'ListItem', position: 2, name: 'Essays', item: 'https://marovole.com/en/#essays' },
      { '@type': 'ListItem', position: 3, name: essay.data.titleEn, item: canonicalUrl },
    ],
  },
];
---

<Layout
  title={`${essay.data.titleEn} | marovole`}
  description={essay.data.descriptionEn}
  image={essay.data.cover}
  lang="en"
  ogType="article"
  publishedTime={`${essay.data.date}T08:00:00+08:00`}
  markdownAlternate={`/essays/${essay.slug}.md`}
  langPaths={{ zh: `/essays/${essay.slug}/`, en: `/en/essays/${essay.slug}/` }}
  extraJsonLd={extraJsonLd}
>
  <EssayDetail essay={essay} lang="en" switchHref={`/essays/${essay.slug}/`} />
</Layout>
