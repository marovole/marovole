---
import Layout from '../../../layouts/Layout.astro';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter(p => p.data.lang === 'zh')
    .map(project => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
const zhProjectSlug = project.slug;
const enProjectSlug = project.data.otherLocaleSlug ?? project.slug;
---

<Layout
  title={`${project.data.title} | marovole`}
  description={project.data.description}
  image={project.data.image}
  langPaths={{ en: `/projects/${enProjectSlug}/`, zh: `/zh/projects/${zhProjectSlug}/` }}
>
  <ProjectDetail project={project} lang="zh" backLink="/zh/#projects" />
</Layout>
