---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => project.data.featured && project.data.lang === 'en')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout
  title={`marovole | ${t('hero.role')}`}
  description="AI-First Product Manager & Vibecoder — Building intelligent products with deep AI integration."
  langPaths={{ en: '/', zh: '/zh' }}
>
  <HomePage lang="en" featuredProjects={featuredProjects} />
</Layout>
